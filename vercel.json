{
    "version": 2,
    "builds": [
        {
            "src": "src/server.ts",
            "use": "@vercel/node"
        }
    ],
    "routes": [
        {
            "src": "/(.*)",
            "dest": "/src/server.ts"
        }
    ],
    "env": {
        "NODE_ENV": "production"
    },
    "functions": {
        "src/server.ts": {
            "maxDuration": 30
        }
    },
    "installCommand": "npm install && npx prisma generate",
    "buildCommand": "npx prisma generate"
}